{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnidocbench-rocm/schemas/artifact-schema.json",
  "schema_version": 1,
  "$defs": {
    "run_stats": {
      "type": "object",
      "required": ["schema_version", "count", "ok", "fail", "fallback", "limit_pages", "stats"],
      "properties": {
        "schema_version": {"const": 1},
        "count": {"type": "integer"},
        "ok": {"type": "integer"},
        "fail": {"type": "integer"},
        "fallback": {"type": "integer"},
        "limit_pages": {"type": ["integer", "null"]},
        "engine": {"type": "string"},
        "stats": {"type": "array", "items": {
          "type": "object",
          "required": ["image", "status"],
          "properties": {
            "image": {"type": "string"},
            "status": {"type": "string"},
            "error": {"type": "string"},
            "seconds": {"type": "number"},
            "attempts": {"type": "integer"}
          }
        }},
        "efficiency": {
          "type": "object",
          "properties": {
            "latency_s_per_page": {"type": "number"},
            "peak_vram_mb": {"type": "integer"},
            "gpu": {"type": "string"}
          },
          "additionalProperties": false
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["schema_version", "created_at_utc", "git_commit", "platform", "engine_version", "model_id", "adapter_command", "dataset_manifest_path", "dataset_revision", "prediction_dir", "page_count", "ok_pages", "failed_pages", "metric_result_paths", "run_summary_paths", "run_stats_path", "backend"],
      "properties": {
        "schema_version": {"const": 1},
        "created_at_utc": {"type": "string"},
        "git_commit": {"type": "string"},
        "platform": {"enum": ["linux-rocm", "windows-hip"]},
        "engine_version": {"type": "string"},
        "model_id": {"type": "string"},
        "adapter_command": {"type": "string"},
        "vlm_server_url": {"type": "string"},
        "api_model_name": {"type": "string"},
        "scoring_config_path": {"type": "string"},
        "dataset_manifest_path": {"type": "string"},
        "dataset_revision": {"type": "string"},
        "prediction_dir": {"type": "string"},
        "page_count": {"type": "integer"},
        "ok_pages": {"type": "integer"},
        "failed_pages": {"type": "integer"},
        "fallback_pages": {"type": "integer"},
        "metric_result_paths": {"type": "array", "items": {"type": "string"}},
        "run_summary_paths": {"type": "array", "items": {"type": "string"}},
        "run_stats_path": {"type": "string"},
        "backend": {"type": "string"},
        "execution_provider": {"type": "string"},
        "backend_family": {"type": "string"},
        "compatibility_status": {"type": "string"},
        "target_backend": {"type": "string"},
        "packaging_commit": {"type": "string"},
        "prediction_source_commit": {"type": "string"},
        "prediction_source_command": {"type": "string"},
        "prediction_source_run_manifest": {"type": "string"},
        "prediction_manifest_path": {"type": "string"},
        "prediction_manifest_sha256": {"type": "string"},
        "dataset_identity_path": {"type": "string"},
        "source_metric_result_path": {"type": "string"},
        "source_run_stats_path": {"type": "string"},
        "source_prediction_dir": {"type": "string"},
        "migration_type": {"type": "string"}
      }
    },
    "run_summary": {
      "type": "object",
      "required": ["schema_version", "save_name", "engine", "cdm", "prediction_count", "ok_pages", "failed_pages", "fallback_pages", "readme_metrics", "metric_quality"],
      "properties": {
        "schema_version": {"const": 1},
        "save_name": {"type": "string"},
        "engine": {"type": "string"},
        "cdm": {"type": "boolean"},
        "prediction_count": {"type": "integer"},
        "ok_pages": {"type": "integer"},
        "failed_pages": {"type": "integer"},
        "fallback_pages": {"type": "integer"},
        "readme_metrics": {
          "type": "object",
          "properties": {
            "text_edit_dist": {"type": ["number", "null"]},
            "reading_order_edit_dist": {"type": ["number", "null"]},
            "table_teds_percent": {"type": ["number", "null"]},
            "formula_cdm_percent": {"type": ["number", "null"]}
          }
        },
        "metric_quality": {
          "type": "object",
          "required": ["formula_cdm"],
          "properties": {"formula_cdm": {
            "type": "object", "required": ["valid"],
            "properties": {"valid": {"type": "boolean"}, "reason": {"type": "string"},
              "sample_count": {"type": ["integer", "null"]}, "exception_case_count": {"type": ["integer", "null"]}}
          }}
        },
        "efficiency": {
          "type": "object",
          "properties": {
            "latency_s_per_page": {"type": "number"},
            "peak_vram_mb": {"type": "integer"},
            "gpu": {"type": "string"}
          },
          "additionalProperties": false
        }
      }
    },
    "repro_recipe": {
      "type": "object",
      "required": ["command", "weights_revision", "backend", "environment"],
      "properties": {
        "command": {"type": "string"},
        "weights_revision": {"type": "string"},
        "backend": {"type": "string"},
        "environment": {"type": "string"}
      },
      "additionalProperties": true
    },
    "model_card": {
      "type": "object",
      "required": ["schema_version", "model_id", "model_version", "platforms", "badge", "eval_date", "omnidocbench_version", "overall", "hardware", "artifacts"],
      "properties": {
        "schema_version": {"const": 1},
        "model_id": {"type": "string"},
        "model_version": {"type": "string"},
        "platforms": {"type": "array", "items": {"enum": ["linux-rocm", "windows-hip"]}},
        "badge": {"type": "object",
          "properties": {
            "linux-rocm": {"enum": ["verified", "community", "community-wanted"]},
            "windows-hip": {"enum": ["verified", "community", "community-wanted"]}
          }},
        "eval_date": {"type": "string"},
        "omnidocbench_version": {"type": "string"},
        "overall": {"type": ["number", "null"]},
        "submetrics": {"type": "object"},
        "hardware": {"type": "object",
          "properties": {"gpu": {"type": "string"}, "vram": {"type": "string"}, "rocm_driver": {"type": "string"}}},
        "artifacts": {"type": "object"},
        "backend": {"type": "string"},
        "execution_provider": {"type": "string"},
        "backend_family": {"type": "string"},
        "compatibility_status": {"type": "string"},
        "target_backend": {"type": "string"},
        "license": {"type": "string"},
        "commercial_use": {"type": "string"}
      }
    },
    "license_record": {
      "type": "object",
      "description": "A normalized license declaration shared by model cards, manifests, and the hub registry. category is the ONLY required field; never default a missing/unclear license to open-source-ai — use unknown (ADR-0010).",
      "required": ["category"],
      "properties": {
        "category": {"enum": ["open-source-ai", "open-weights", "source-available", "restricted", "closed", "unknown"]},
        "spdx": {"type": "string", "description": "SPDX identifier e.g. Apache-2.0, empty when non-SPDX"},
        "name": {"type": "string", "description": "Human license name e.g. Tencent Hunyuan Community License"},
        "url": {"type": "string"},
        "commercial_use": {"type": "string", "description": "free-text summary; 'permitted' | 'restricted' | a clause"},
        "geographic_restrictions": {"type": "string", "description": "e.g. 'not licensed in EU/UK/KR'; empty when none"},
        "acceptable_use_restrictions": {"type": "string", "description": "AUP-style usage limits; empty when none"}
      },
      "additionalProperties": true
    },
    "result_record": {
      "type": "object",
      "description": "The canonical result record — the single source of truth for ONE combination of platform + backend + precision + benchmark (ADR-0007, ADR-0012). result_id is unique AND reproducibly generated from the tuple. retracted/invalid/superseded records are RETAINED, never deleted. metrics is intentionally extensible (additionalProperties true) so new metrics do not require a schema bump.",
      "required": ["result_id", "status", "assurance", "benchmark", "metrics", "provenance"],
      "properties": {
        "result_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,191}$"},
        "status": {"enum": ["valid", "invalid", "retracted", "superseded"]},
        "assurance": {"enum": ["submitted", "evidence-complete", "score-reproduced", "inference-reproduced", "cross-hardware-reproduced"]},
        "primary": {"type": "boolean", "description": "explicit flag marking this as the model's primary result; NEVER auto-assigned to the highest score (ADR-0012)"},
        "producer_assurance": {"enum": ["submitted", "evidence-complete"], "description": "Round-2 (ADR-0013): producer-OWNED evidence depth — what the model repo SUBMITTED. The central platform never rewrites this. The legacy `assurance` field is retained as a lossy back-compat projection."},
        "run_spec": {"$ref": "#/$defs/run_spec_record"},
        "run_spec_hash": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$", "description": "Round-2 (ADR-0015): sha256 of canonical_json(run_spec). Same run_spec -> same hash -> same result identity. A valid result must NOT carry backend/precision == 'default' (the v2 anti-pattern); unknown must be the literal 'unknown'."},
        "comparison_track_id": {"type": "string", "description": "Round-2 (ADR-0016): the comparison track this result belongs to. Results are compared ONLY within a track."},
        "legacy_result_ids": {"type": "array", "items": {"type": "string"}, "description": "Round-2 (ADR-0015): prior result_id values superseded by this identity (v2->v3 migration). Retained for traceability; never deleted."},
        "topology": {"type": "object", "additionalProperties": true, "description": "Round-2 (ADR-0017): runtime topology — embedded-python | managed-local-server | external-server | native-binary."},
        "components": {"type": "object", "additionalProperties": {"$ref": "#/$defs/component_record"}, "description": "Round-2 (ADR-0017): per-stage components (layout/vlm/ocr/rendering/postprocessing) for composite pipelines."},
        "accelerator_family": {"enum": ["rocm", "hip", "directml", "cpu", "mixed"], "description": "Round-2 (ADR-0017): whole-pipeline accelerator classification. A mixed pipeline (e.g. DirectML layout + HIP VLM) is 'mixed', NEVER 'rocm'."},
        "benchmark": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string"},
            "version": {"type": "string"},
            "metric_set": {"type": "string"}
          },
          "additionalProperties": true
        },
        "implementation": {
          "type": "object",
          "properties": {
            "backend": {"type": "string"},
            "execution_provider": {"type": "string"},
            "precision": {"type": "string"},
            "serving_stack": {"type": "string"},
            "engine_version": {"type": "string"}
          },
          "additionalProperties": true
        },
        "coverage": {
          "type": "object",
          "properties": {
            "platform": {"enum": ["linux-rocm", "windows-hip"]},
            "page_count": {"type": "integer"},
            "full_set": {"type": "boolean"},
            "categories": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        },
        "metrics": {
          "type": "object",
          "required": ["overall"],
          "properties": {
            "overall": {"type": ["number", "null"]}
          },
          "additionalProperties": true
        },
        "hardware": {
          "type": "object",
          "properties": {
            "gpu": {"type": "string"},
            "vram_mb": {"type": "integer"},
            "rocm_driver": {"type": "string"},
            "cpu": {"type": "string"},
            "memory_gb": {"type": "integer"}
          },
          "additionalProperties": true
        },
        "software": {
          "type": "object",
          "properties": {
            "os": {"type": "string"},
            "python": {"type": "string"},
            "rocm": {"type": "string"},
            "packages": {"type": "object"}
          },
          "additionalProperties": true
        },
        "artifacts": {
          "type": "object",
          "properties": {
            "run_summary": {"type": "string"},
            "provenance": {"type": "string"},
            "metric_result": {"type": "string"},
            "prediction_manifest": {"type": "string"},
            "dataset_identity": {"type": "string"},
            "prediction_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
            "metric_result_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}
          },
          "additionalProperties": true
        },
        "provenance": {
          "type": "object",
          "description": "Provenance block. Base validity only requires the block exist; inner fields are optional because their PRESENCE is a depth/assurance concern, enforced by the conformance profiles (evidence-complete requires created_at_utc+git_commit+artifacts; reproducible-score requires dataset hashes). This keeps legacy-card migration structurally valid while profiles enforce completeness.",
          "properties": {
            "created_at_utc": {"type": "string", "format": "date-time"},
            "git_commit": {"type": "string"},
            "engine_version": {"type": "string"},
            "adapter_command": {"type": "string"},
            "dataset_revision": {"type": "string"},
            "dataset_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
            "reproduced_by": {"type": "string"},
            "reproduced_at_utc": {"type": "string", "format": "date-time"},
            "reproduction_backend": {"type": "string"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "model_card_v2": {
      "type": "object",
      "description": "Model Card v2 (schema_version 2). results[] holds one result_record per platform+backend+precision+benchmark combination. platforms is DERIVED from results (validate_card_v2 recomputes it); when present in the file it must match the derivation. primary_result_id (when set) is an explicit choice, never auto-pick-highest (ADR-0007, ADR-0012).",
      "required": ["schema_version", "model_id", "results"],
      "properties": {
        "schema_version": {"const": 2},
        "model_id": {"type": "string"},
        "model_version": {"type": "string"},
        "upstream": {"type": "object", "additionalProperties": true},
        "license": {"$ref": "#/$defs/license_record"},
        "platforms": {"type": "array", "items": {"type": "string"}},
        "primary_result_id": {"type": "string"},
        "primary_selection": {"$ref": "#/$defs/primary_selection_record"},
        "comparison_tracks": {"type": "array", "items": {"$ref": "#/$defs/comparison_track_record"}},
        "licenses": {"type": "object", "properties": {"code": {"$ref": "#/$defs/code_license_record"}, "model": {"$ref": "#/$defs/model_openness_record"}}, "additionalProperties": true, "description": "Round-2 (ADR-0014): split of code license vs model openness. The legacy single `license` field is retained as a back-compat projection."},
        "results": {"type": "array", "items": {"$ref": "#/$defs/result_record"}, "minItems": 1}
      },
      "additionalProperties": true
    },
    "rocmdoc_manifest": {
      "type": "object",
      "description": "rocmdoc.yaml — a CAPABILITY declaration, NOT a benchmark result (ADR-0009). Declares what the model CAN do and under what license; the result_record records what was actually measured. result-alignment validation forbids a result from claiming a platform/backend the manifest does not declare (no faking supported platforms).",
      "required": ["schema_version", "project", "upstream", "model", "licenses", "interfaces", "implementations"],
      "properties": {
        "schema_version": {"const": 1},
        "project": {
          "type": "object",
          "required": ["name"],
          "properties": {"name": {"type": "string"}, "description": {"type": "string"}, "repo": {"type": "string"}, "homepage": {"type": "string"}},
          "additionalProperties": true
        },
        "upstream": {
          "type": "object",
          "required": ["name"],
          "properties": {"name": {"type": "string"}, "repo": {"type": "string"}, "revision": {"type": "string"}, "url": {"type": "string"}},
          "additionalProperties": true
        },
        "model": {
          "type": "object",
          "required": ["id"],
          "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "task": {"type": "string"}, "arch": {"type": "string"}, "params_b": {"type": "number"}},
          "additionalProperties": true
        },
        "licenses": {
          "type": "object",
          "properties": {"code": {"$ref": "#/$defs/license_record"}, "weights": {"$ref": "#/$defs/license_record"}},
          "additionalProperties": true
        },
        "interfaces": {"type": "array", "items": {"enum": ["standard-cli", "adapter-script", "api-server"]}, "minItems": 1},
        "implementations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["platform", "backend"],
            "properties": {
              "platform": {"enum": ["linux-rocm", "windows-hip"]},
              "backend": {"type": "string"},
              "precision": {"type": "string"},
              "interface": {"enum": ["standard-cli", "adapter-script", "api-server"]},
              "status": {"enum": ["supported", "planned", "experimental", "unsupported"]}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "cli_version": {
      "type": "object",
      "description": "The JSON emitted by `<adapter-cli> version --json` (standard CLI contract, ADR-0011).",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "engine_version": {"type": "string"},
        "schema_version": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "cli_capabilities": {
      "type": "object",
      "description": "The JSON emitted by `<adapter-cli> capabilities --json` (standard CLI contract, ADR-0011). Declares supported platforms/backends/interfaces — must agree with rocmdoc.yaml.",
      "required": ["platforms"],
      "properties": {
        "platforms": {"type": "array", "items": {
          "type": "object",
          "required": ["platform", "backend"],
          "properties": {
            "platform": {"enum": ["linux-rocm", "windows-hip"]},
            "backend": {"type": "string"},
            "precision": {"type": "string"},
            "interface": {"enum": ["standard-cli", "adapter-script", "api-server"]}
          },
          "additionalProperties": true
        }},
        "interfaces": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "cli_result": {
      "type": "object",
      "description": "Canonical result.json emitted by `<adapter-cli> parse ... --json` and by the CLI->adapter bridge (standard CLI contract, ADR-0011). status: ok = full set parsed, partial = some pages failed (run continued, never raised), failed = could not produce output. Exit codes are normative in contracts/cli-contract.md.",
      "required": ["schema_version", "status", "pages"],
      "properties": {
        "schema_version": {"const": 1},
        "status": {"enum": ["ok", "partial", "failed"]},
        "backend": {"type": "string"},
        "engine": {"type": "string"},
        "page_count": {"type": "integer"},
        "ok": {"type": "integer"},
        "failed": {"type": "integer"},
        "skipped": {"type": "integer"},
        "output_dir": {"type": "string"},
        "full_set": {"type": "boolean"},
        "pages": {"type": "array", "items": {
          "type": "object",
          "required": ["image", "status"],
          "properties": {
            "image": {"type": "string"},
            "status": {"enum": ["ok", "failed", "skipped"]},
            "error": {"type": "string"},
            "seconds": {"type": "number"}
          },
          "additionalProperties": true
        }}
      },
      "additionalProperties": true
    },
    "canonical_result": {
      "type": "object",
      "description": "One entry in hub/canonical_results.json — the central repo's single source of truth for a measured score (ADR-0012). The hub comparison table and the README generated-results section are DERIVED from this; nothing hand-writes a score. assurance + status are per-result and never propagated across results.",
      "required": ["result_id", "model_id", "platform", "benchmark", "overall", "assurance", "status"],
      "properties": {
        "result_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,191}$"},
        "model_id": {"type": "string"},
        "platform": {"enum": ["linux-rocm", "windows-hip"]},
        "backend": {"type": "string"},
        "precision": {"type": "string"},
        "benchmark": {"type": "object", "required": ["name", "version"], "additionalProperties": true},
        "overall": {"type": ["number", "null"]},
        "submetrics": {"type": "object"},
        "assurance": {"enum": ["submitted", "evidence-complete", "score-reproduced", "inference-reproduced", "cross-hardware-reproduced"]},
        "status": {"enum": ["valid", "invalid", "retracted", "superseded"]},
        "primary": {"type": "boolean"},
        "license_category": {"enum": ["open-source-ai", "open-weights", "source-available", "restricted", "closed", "unknown"]},
        "producer_assurance": {"enum": ["submitted", "evidence-complete"], "description": "Round-2 (ADR-0013): copied verbatim from the source model-repo result; central never rewrites it."},
        "platform_review": {"$ref": "#/$defs/platform_review_record"},
        "comparison_track_id": {"type": "string"},
        "run_spec_hash": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "source": {"$ref": "#/$defs/source_reference_record", "description": "Round-2 (ADR-0013): immutable source reference back to the model-repo canonical result/card. An imported canonical_result MUST carry a source; absence means not-yet-imported (registry-only stub)."},
        "eval_date": {"type": "string", "format": "date"},
        "note": {"type": "string"}
      },
      "additionalProperties": true
    },
    "run_spec_record": {
      "type": "object",
      "description": "Round-2 (ADR-0015) Identity v3 run specification. The COMPLETE set of fields that scientifically affect a result. canonical_json(run_spec) -> sha256 -> run_spec_hash -> result_id (v3). Unknown values MUST be the literal string 'unknown' — never masked as a default. A scientifically-material change in any field produces a NEW run_spec_hash and therefore a NEW result identity.",
      "properties": {
        "model": {"type": "object", "description": "model_id, model_revision, weights_revision, weights_sha256 (when obtainable).", "additionalProperties": true},
        "implementation": {"type": "object", "description": "implementation_id, platform, topology, backend, backend_version, precision, quantization, architecture, components.", "additionalProperties": true},
        "benchmark": {"type": "object", "description": "benchmark_id, benchmark_version, dataset_revision, dataset_subset, page_set_hash, scorer_revision, scoring_protocol.", "additionalProperties": true},
        "inference": {"type": "object", "description": "prompt_hash, preprocessing_config_hash, postprocessing_config_hash, runtime_config_hash.", "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "component_record": {
      "type": "object",
      "description": "Round-2 (ADR-0017) one stage of a composite pipeline. requested_provider and actual_provider are recorded SEPARATELY; a CPU preprocessing stage or a DirectML layout stage must not be labeled rocm. A component change feeds into run_spec_hash.",
      "properties": {
        "engine": {"type": "string"},
        "runtime": {"type": "string"},
        "execution_provider": {"type": "string"},
        "requested_provider": {"type": "string"},
        "actual_provider": {"type": "string"},
        "actual_provider_required": {"type": "boolean"},
        "model": {"type": "string"},
        "acceleration": {"type": "string"},
        "dpi": {"type": "integer"},
        "revision": {"type": "string"}
      },
      "additionalProperties": true
    },
    "platform_review_record": {
      "type": "object",
      "description": "Round-2 (ADR-0013) central-platform INDEPENDENT review of an imported result. Orthogonal to producer_assurance. Lives ONLY on the central imported record, NEVER in a model-repo card. Default status is not-reviewed; a legacy `verified` badge does NOT migrate to score-reproduced without a real review record. score-reproduced requires a real scorer replay artifact; inference-reproduced requires real GPU evidence; cross-hardware-reproduced requires a second hardware's evidence.",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["not-reviewed", "accepted", "rejected", "needs-more-evidence"]},
        "assurance": {"enum": ["evidence-accepted", "score-reproduced", "inference-reproduced", "cross-hardware-reproduced"]},
        "reviewer": {"type": "object", "properties": {"id": {"type": "string"}, "type": {"enum": ["human", "trusted-runner"]}}, "additionalProperties": true},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "review_commit": {"type": "string"},
        "review_artifacts": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "source_reference_record": {
      "type": "object",
      "description": "Round-2 (ADR-0013) immutable pointer to the model-repo artifact a central imported result was derived from. commit MUST be a full 40-hex SHA (no main/master/latest floating refs). source_sha256 is recomputed and verified at import. Same source -> idempotent import; changed source -> NEW import record (the old one is never overwritten).",
      "required": ["repository", "commit", "path", "source_sha256"],
      "properties": {
        "repository": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string"},
        "json_pointer": {"type": "string"},
        "source_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}
      },
      "additionalProperties": true
    },
    "import_record": {
      "type": "object",
      "description": "Round-2 (ADR-0013) a central import of a model-repo canonical result. imported_result is the source result VERBATIM (score never mutated); producer_assurance is copied from the source; platform_review defaults to not-reviewed and is set only by a separate review step. Import is idempotent and never overwrites a prior import.",
      "required": ["source", "imported_at", "importer_version", "import_schema_version", "imported_result"],
      "properties": {
        "source": {"$ref": "#/$defs/source_reference_record"},
        "imported_at": {"type": "string", "format": "date-time"},
        "importer_version": {"type": "string"},
        "import_schema_version": {"type": "integer"},
        "imported_result": {"type": "object", "additionalProperties": true},
        "producer_assurance": {"enum": ["submitted", "evidence-complete"]},
        "platform_review": {"$ref": "#/$defs/platform_review_record"}
      },
      "additionalProperties": true
    },
    "comparison_track_record": {
      "type": "object",
      "description": "Round-2 (ADR-0016) a comparison track. Results are compared ONLY within a track. Different benchmark version / scorer protocol / dataset subset (full vs canary, layout-only vs full document) => different track. External paper results never enter a ROCm track. Track definitions are versioned; a content change yields a new track_id or version.",
      "required": ["track_id", "benchmark"],
      "properties": {
        "track_id": {"type": "string"},
        "version": {"type": "string"},
        "benchmark": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}}, "additionalProperties": true},
        "dataset": {"type": "object", "additionalProperties": true},
        "scorer": {"type": "object", "additionalProperties": true},
        "eligibility": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "primary_selection_record": {
      "type": "object",
      "description": "Round-2 (ADR-0016) explicit primary-result selection. NEVER auto-pick-highest. The selected result must be valid and belong to the named track. Superseded/retracted/invalid results can never be primary. Selection history is retained.",
      "required": ["model_id", "comparison_track_id", "result_id"],
      "properties": {
        "model_id": {"type": "string"},
        "comparison_track_id": {"type": "string"},
        "result_id": {"type": "string"},
        "selected_by": {"type": "string"},
        "selected_at": {"type": "string", "format": "date-time"},
        "rationale": {"type": "string"},
        "policy_version": {"type": "string"}
      },
      "additionalProperties": true
    },
    "code_license_record": {
      "type": "object",
      "description": "Round-2 (ADR-0014) code (software) license, SEPARATE from model/weights openness. Apache-2.0 code is open-source-software, which does NOT imply the weights are open-source-ai.",
      "required": ["category"],
      "properties": {
        "category": {"enum": ["open-source-software", "proprietary", "unknown"]},
        "spdx": {"type": "string"},
        "url": {"type": "string"}
      },
      "additionalProperties": true
    },
    "model_openness_record": {
      "type": "object",
      "description": "Round-2 (ADR-0014) model/weights openness, SEPARATE from code license. Weights being downloadable does NOT imply open-source-ai. When uncertain use 'unknown' with an assessment_basis. Special licenses (e.g. Tencent Hunyuan Community License) must be expressed accurately, usually source-available/restricted with geographic + acceptable-use restrictions.",
      "required": ["category"],
      "properties": {
        "category": {"enum": ["open-source-ai", "open-weights", "source-available", "restricted", "closed", "unknown"]},
        "weights_license": {"type": "string"},
        "assessment_basis": {"type": "string"},
        "commercial_use": {"type": "string"},
        "geographic_restrictions": {"type": "array", "items": {"type": "string"}},
        "acceptable_use_restrictions": {"type": "array", "items": {"type": "string"}},
        "attribution_required": {"type": "boolean"},
        "url": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
